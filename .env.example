# Neon Postgres connection URL. Connect Neon in Vercel Storage / Marketplace.
DATABASE_URL=
# Shared organizer login. Generate hash/session secret with scripts/setup-auth.ts.
ORGANIZER_USERNAME=
ORGANIZER_PASSWORD_HASH=
ORGANIZER_SESSION_SECRET=
# Optional: readonly sample data. Set false for the real event.
DEMO_MODE=false
# Stop booth submissions after the competition. Organizer corrections still work.
SUBMISSIONS_OPEN=true
